# Supabase Dashboard > Project Settings > Database의 서버 연결 정보를 입력합니다.
# 비밀번호가 포함된 실제 .env 파일은 Git에 올리지 않습니다.
DB_URL=jdbc:postgresql://HOST:5432/postgres?currentSchema=mealfit
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=change-me

# 32바이트 이상의 무작위 문자열을 사용합니다.
JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRATION_SECONDS=3600

AI_SERVER_URL=http://localhost:8000

# AI 서버가 원가 API(/api/cost/menus)를 호출할 때 사용하는 Backend 주소입니다.
# Docker로 분리해 배포하면 localhost가 아니라 Backend 컨테이너/서버 주소를 입력합니다.
BACKEND_URL=http://localhost:8080
